#: crates/app/ui/main.slint:57
msgctxt "MainWindow"
msgid "Starting {}…"
msgstr "Uruchamianie {}…"

#: crates/app/ui/main.slint:58
msgctxt "MainWindow"
msgid "{} is missing from the game folder. Use Check files in the tools."
msgstr "Brak pliku {} w folderze gry. Użyj „Sprawdź pliki” w narzędziach."

#: crates/app/ui/main.slint:59
msgctxt "MainWindow"
msgid ""
"The game needs Wine. Install it from your distribution's packages and try "
"again."
msgstr "Gra wymaga Wine. Zainstaluj go z pakietów swojej dystrybucji i spróbuj ponownie."

#: crates/app/ui/main.slint:60
msgctxt "MainWindow"
msgid "Could not start {}."
msgstr "Nie udało się uruchomić {}."

#: crates/app/ui/main.slint:61
msgctxt "MainWindow"
msgid "{} closed right after starting. Try Check files in the tools."
msgstr "{} zamknął się zaraz po uruchomieniu. Spróbuj „Sprawdź pliki” w narzędziach."

#: crates/app/ui/main.slint:62
msgctxt "MainWindow"
msgid "Cache cleared."
msgstr "Cache wyczyszczony."

#: crates/app/ui/main.slint:63
msgctxt "MainWindow"
msgid "Could not clear the cache. Close the game and try again."
msgstr "Nie udało się wyczyścić cache. Zamknij grę i spróbuj ponownie."

#: crates/app/ui/main.slint:64
msgctxt "MainWindow"
msgid "Starting…"
msgstr "Uruchamianie…"

#: crates/app/ui/main.slint:65
msgctxt "MainWindow"
msgid "Updating the launcher…"
msgstr "Aktualizacja launchera…"

#: crates/app/ui/main.slint:66
msgctxt "MainWindow"
msgid "Checking for updates…"
msgstr "Sprawdzanie aktualizacji…"

#: crates/app/ui/main.slint:67
msgctxt "MainWindow"
msgid "Checking files… {}/{}"
msgstr "Sprawdzanie plików… {}/{}"

#: crates/app/ui/main.slint:68
msgctxt "MainWindow"
msgid "Downloading {}/{}  ({} / {})  ·  {}"
msgstr "Pobieranie {}/{}  ({} / {})  ·  {}"

#: crates/app/ui/main.slint:69
msgctxt "MainWindow"
msgid "Up to date — ready to play."
msgstr "Gra jest aktualna — możesz grać."

#: crates/app/ui/main.slint:70
msgctxt "MainWindow"
msgid "Updated to {} — ready to play."
msgstr "Zaktualizowano do {} — możesz grać."

#: crates/app/ui/main.slint:71
msgctxt "MainWindow"
msgid "The update server is missing a file. Try again later."
msgstr "Na serwerze aktualizacji brakuje pliku. Spróbuj później."

#: crates/app/ui/main.slint:72
msgctxt "MainWindow"
msgid "Could not write to the game folder. Close the game and try again."
msgstr "Nie można zapisać w folderze gry. Zamknij grę i spróbuj ponownie."

#: crates/app/ui/main.slint:73
msgctxt "MainWindow"
msgid "The update server sent an invalid file list. Try again later."
msgstr "Serwer aktualizacji przysłał błędną listę plików. Spróbuj później."

#: crates/app/ui/main.slint:74
msgctxt "MainWindow"
msgid "Could not update. Check your connection and try again."
msgstr "Nie udało się zaktualizować. Sprawdź połączenie i spróbuj ponownie."

#: crates/app/ui/main.slint:81
msgctxt "MainWindow"
msgid "Enter a full path, e.g. {}."
msgstr "Podaj pełną ścieżkę, np. {}."

#: crates/app/ui/main.slint:82
msgctxt "MainWindow"
msgid "No permission to write to this folder. Choose another one."
msgstr "Brak uprawnień do zapisu w tym folderze. Wybierz inny."

#: crates/app/ui/main.slint:83
msgctxt "MainWindow"
msgid "Could not install to this folder. Choose another one."
msgstr "Nie udało się zainstalować w tym folderze. Wybierz inny."

#: crates/app/ui/main.slint:266
msgctxt "MainWindow"
msgid "Retry"
msgstr "Ponów"

#: crates/app/ui/main.slint:272
msgctxt "MainWindow"
msgid "PLAY"
msgstr "GRAJ"

#: crates/app/ui/main.slint:283
msgctxt "MainWindow"
msgid "TOOLS"
msgstr "NARZĘDZIA"

#: crates/app/ui/main.slint:287
msgctxt "MainWindow"
msgid "Clear cache"
msgstr "Wyczyść cache"

#: crates/app/ui/main.slint:288
msgctxt "MainWindow"
msgid "Deletes {} — the game rebuilds it on the next start."
msgstr "Usuwa {} — gra odtworzy go przy następnym starcie."

#: crates/app/ui/main.slint:293
msgctxt "MainWindow"
msgid "Check files"
msgstr "Sprawdź pliki"

#: crates/app/ui/main.slint:294
msgctxt "MainWindow"
msgid "Checks every game file and downloads damaged ones again."
msgstr "Sprawdza każdy plik gry i ponownie pobiera uszkodzone."

#: crates/app/ui/main.slint:302
msgctxt "MainWindow"
msgid "Open game folder"
msgstr "Otwórz folder gry"

#: crates/app/ui/main.slint:312
msgctxt "MainWindow"
msgid "About"
msgstr "O programie"

#: crates/app/ui/main.slint:317 crates/app/ui/main.slint:435
msgctxt "MainWindow"
msgid "Close"
msgstr "Zamknij"

#: crates/app/ui/main.slint:325
msgctxt "MainWindow"
msgid "CLEAR CACHE"
msgstr "CZYSZCZENIE CACHE"

#: crates/app/ui/main.slint:328
msgctxt "MainWindow"
msgid "Delete {}? Nothing else in the game folder is touched."
msgstr "Usunąć {}? Nic innego w folderze gry nie zostanie ruszone."

#: crates/app/ui/main.slint:340 crates/app/ui/main.slint:405
msgctxt "MainWindow"
msgid "Cancel"
msgstr "Anuluj"

#: crates/app/ui/main.slint:345
msgctxt "MainWindow"
msgid "Delete"
msgstr "Usuń"

#: crates/app/ui/main.slint:357
msgctxt "MainWindow"
msgid "WHERE TO INSTALL"
msgstr "GDZIE ZAINSTALOWAĆ"

#: crates/app/ui/main.slint:361
msgctxt "MainWindow"
msgid ""
"Choose a folder for the game. The launcher moves itself there and downloads "
"the game files. A folder that already has the game is fine — only missing "
"or outdated files are downloaded."
msgstr "Wybierz folder na grę. Launcher przeniesie się tam i pobierze pliki gry. Może to być folder z już zainstalowaną grą — pobrane zostaną tylko brakujące lub nieaktualne pliki."

#: crates/app/ui/main.slint:371
msgctxt "MainWindow"
msgid "Game folder"
msgstr "Folder gry"

#: crates/app/ui/main.slint:375
msgctxt "MainWindow"
msgid "Browse…"
msgstr "Przeglądaj…"

#: crates/app/ui/main.slint:393
msgctxt "MainWindow"
msgid "Create a shortcut on the desktop and in the menu"
msgstr "Utwórz skrót na pulpicie i w menu"

#: crates/app/ui/main.slint:410
msgctxt "MainWindow"
msgid "Install"
msgstr "Zainstaluj"

#: crates/app/ui/main.slint:419
msgctxt "MainWindow"
msgid "ABOUT"
msgstr "O PROGRAMIE"
