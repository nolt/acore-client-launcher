# Build environment for the launcher. Bookworm on purpose: the Linux binary links
# against this glibc (2.36), so an older base runs on more distributions.
FROM rust:1-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
        libfontconfig1-dev \
        libxkbcommon-x11-0 libx11-xcb1 libxcursor1 libxi6 libxrandr2 \
        xvfb imagemagick xdotool gettext \
        gcc-mingw-w64-x86-64 \
        libgl1 libegl1 libgl1-mesa-dri \
    && rm -rf /var/lib/apt/lists/*

# Not part of the base image's minimal toolchain; the Windows target builds
# the .exe with MinGW.
RUN rustup component add rustfmt clippy && rustup target add x86_64-pc-windows-gnu
